#!/bin/sh

# Keep first boot LAN-safe. The HG680P rtl8189fs driver loads correctly from
# the custom kernel, but wireless userspace must be enabled manually after LAN
# and LuCI are confirmed stable.
if [ -x /etc/init.d/wpad ]; then
    /etc/init.d/wpad disable || true
fi

rm -f /etc/config/wireless

exit 0
