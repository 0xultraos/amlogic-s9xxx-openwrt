# Minimal functional package additions for HG680P OpenWrt image.
# ImageBuilder keeps the default profile packages; these lines add only:
# - LuCI base web UI
# - OpenWrt Wi-Fi userspace required to bring up AP mode
# - USB tethering kmods

# LuCI base web UI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y

# Wi-Fi userspace for mac80211 AP mode
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

# USB network base
CONFIG_PACKAGE_kmod-usb-net=y

# Android USB tethering and generic USB Ethernet tethering
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y

# iPhone/iPad USB tethering kernel driver
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
